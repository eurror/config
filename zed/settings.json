{
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "indent_guides": {
    "background_coloring": "indent_aware",
  },
  "agent": {
    "threads_sidebar": {
      "position": "right",
    },
    "dock": "right",
  },
  "prettier": {
    "allowed": true,
  },
  "show_whitespaces": "all",
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "toolbar": {
    "code_actions": true,
  },
  "minimap": {
    "show": "auto",
  },
  "diff_view_style": "unified",
  "which_key": {
    "delay_ms": 0,
    "enabled": true,
  },
  "autosave": "on_focus_change",
  "cursor_animation": {
    "enabled": true,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "cursor_blink": false,
  "icon_theme": "Material Icon Theme",
  "theme": {
    "dark": "VSCode Dark Modern",
    "light": "VSCode Dark Modern",
  },
  "git_panel": {
    "tree_view": true,
    "group_by": "none",
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
  },
}
