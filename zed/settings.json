{
    "languages": {
        "Java": {
            "tab_size": 2
        }
    },
    "git_panel": {
        "dock": "left"
    },
    "project_panel": {
        "dock": "left"
    },
    /* Duplicated key auto-commented: "agent": {
        "dock": "right",
        "favorite_models": [],
        "model_parameters": []
    }, */
    "edit_predictions": {
        "provider": "zed",
        "mode": "eager",
        "copilot": {
            "proxy": null,
            "proxy_no_verify": null
        },
        "enabled_in_text_threads": false
    },
    "vim_mode": true,
    "icon_theme": "VSCode Great Icons Theme",
    "terminal": {
        "dock": "bottom",
        "font_size": 14,
        "env": {
            "PYTHONUNBUFFERED": "1"
        }
    },
    "buffer_font_size": 13,
    "theme": {
        "dark": "VSCode Dark Modern",
        "light": "VSCode Dark Modern",
        "font_size": 13,
        "font_family": "JetBrains Mono, Menlo, Monaco, Courier New, monospace"
    },
    "agent": {
        "favorite_models": [
            {
                "provider": "anthropic",
                "model": "claude-sonnet-5-5",
                "enable_thinking": true,
                "effort": "high"
            },
            {
                "provider": "anthropic",
                "model": "claude-opus-5-5",
                "enable_thinking": true,
                "effort": "high"
            }
        ],
        "threads_sidebar": {
            "position": "right"
        },
        "dock": "right",
        "default_model": {
            "effort": "high",
            "enable_thinking": true,
            "provider": "anthropic",
            "model": "claude-opus-5-5"
        },
    },
    "telemetry": {
        "metrics": false,
        "diagnostics": false
    },
    "cursor_blink": false,
    "cursor_shape": "block",
    "autosave": { "after_delay": { "milliseconds": 0 } },
    "soft_wrap": "editor_width",
    "relative_line_numbers": "enabled",
    "indent_guides": {
        "enabled": true,
        "coloring": "indent_aware",
        "background_coloring": "indent_aware"
    },
    "format_on_paste": true,
    "format_on_save": "on",
    "tab_size": 4,
    "preferred_line_length": 100,
    "show_whitespaces": "none",
    "show_indent_guide": true,
    "language_overrides": {
        "Python": {
            "format_on_save": true,
            "tab_size": 4
        },
        "HTML": {
            "tab_size": 2
        },
        "CSS": {
            "tab_size": 2
        },
        "JavaScript": {
            "tab_size": 4
        },
        "JSON": {
            "tab_size": 4
        },
        "YAML": {
            "tab_size": 4
        }
    },
    "lsp": {
        "pyright": {
            "settings": {
                "python.analysis": {
                    "diagnosticMode": "openFilesOnly",
                    "typeCheckingMode": "off"
                },
                "python": {
                    "pythonPath": ".venv/bin/python"
                }
            }
        }
    },
    "project_panel.default_width": 300,
    "outline_panel.default_width": 300,
    "collaboration_panel.default_width": 300,
    "chat_panel.default_width": 300,
    "git_panel.default_width": 300,
    "notification_panel.default_width": 300,
    "agent.default_width": 300,
    "terminal.default_height": 300,
}
